# ---- dependencies ----
node_modules/
package-lock.json.bak

# ---- build / cache ----
# 注意：这些必须锚定到仓库根目录（前导 `/`）。
# 不锚定的 `build/` 会匹配任意深度的同名目录，曾把 vendor/three/build/
# 整个忽略掉 —— 而那是 index.html importmap 指向的 three 运行时核心，
# 导致 clone 后根本跑不起来。同类规则一律锚定。
/dist/
/build/
.cache/
.parcel-cache/
.vite/
*.tsbuildinfo

# ---- logs ----
*.log
npm-debug.log*
yarn-error.log*

# ---- OS / editor ----
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
.idea/
.vscode/
*.swp
*~

# ---- temp / scratch ----
tmp/
temp/
*.tmp
*.bak
*.orig

# ---- ego / agent scratch ----
# 调试脚本与 ego 工作区产物不进仓库
ego/
*.mjs.bak
scratch/

# ---- wrangler 本地状态 / 干跑产物 ----
.wrangler/
.wrangler-dry-run/

# ---- 本地验证 / 测试产物（不进版本库）----
# 截图、录屏、测试输出等属于「一次性验证产物」：随时会重截、会膨胀体积、
# 会污染 git 历史；它们只用于本地自查与向用户证明效果，不作为项目资产入库。
screenshots/

# 说明（本地产物 vs 项目资产）：
#  screenshots/  排除 —— 视觉验证产物，非资产
#  tests/        保留 —— 自动化测试「代码」是项目资产
#  docs/         保留 —— 正式文档
#  scripts/      保留 —— 构建/部署脚本
#  node_modules/ 排除 —— 用 npm install 还原
